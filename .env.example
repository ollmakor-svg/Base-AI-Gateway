# Required: long random secrets. Never commit real values.
GATEWAY_API_KEY=replace-with-a-long-random-client-key
PORT=8787
HOST=0.0.0.0
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=60000

# OmniRoute is the primary upstream model router.
# Set the URL to your OmniRoute API base ending in /v1.
# Use an actual API key created/configured in OmniRoute; never commit it.
# "auto" requires OmniRoute auto-routing to be enabled.
PROVIDERS_JSON=[{"name":"omniroute","baseUrl":"http://omniroute:20128/v1","apiKey":"YOUR_OMNIROUTE_SERVER_API_KEY","model":"auto","enabled":true}]
