# Required: long random secrets. Never commit real values.
GATEWAY_API_KEY=replace-with-a-long-random-client-key
PORT=8787
HOST=0.0.0.0
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=60000

# Configure one or more OpenAI-compatible providers as a JSON array.
# Add provider API keys only as deployment environment variables.
PROVIDERS_JSON=[{"name":"groq","baseUrl":"https://api.groq.com/openai/v1","apiKey":"YOUR_GROQ_KEY","model":"YOUR_GROQ_MODEL","enabled":true},{"name":"openrouter","baseUrl":"https://openrouter.ai/api/v1","apiKey":"YOUR_OPENROUTER_KEY","model":"YOUR_OPENROUTER_MODEL","enabled":true}]
